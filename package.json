{
  "name": "agent-unit",
  "version": "0.2.0",
  "description": "Durable runs, pauses and state for any agent framework, on any host.",
  "keywords": [
    "agents",
    "ai",
    "durable",
    "runtime",
    "nitro",
    "mcp",
    "a2a",
    "ai-sdk",
    "mastra",
    "langgraph"
  ],
  "license": "MIT",
  "author": "Farming Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farming-labs/agent-unit.git"
  },
  "homepage": "https://github.com/farming-labs/agent-unit#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "agent-unit": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "spec"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "import": "./dist/runtime.mjs"
    },
    "./adapter": {
      "types": "./dist/adapter.d.mts",
      "import": "./dist/adapter.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./build": {
      "types": "./dist/build.d.mts",
      "import": "./dist/build.mjs"
    },
    "./nitro": {
      "types": "./dist/nitro.d.mts",
      "import": "./dist/nitro.mjs"
    },
    "./cloudflare": {
      "types": "./dist/cloudflare.d.mts",
      "import": "./dist/cloudflare.mjs"
    },
    "./redis": {
      "types": "./dist/redis.d.mts",
      "import": "./dist/redis.mjs"
    },
    "./env": {
      "types": "./dist/env.d.mts",
      "workerd": "./dist/env.workerd.mjs",
      "worker": "./dist/env.workerd.mjs",
      "import": "./dist/env.mjs"
    },
    "./presets/mastra": {
      "types": "./dist/presets/mastra.d.mts",
      "import": "./dist/presets/mastra.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.mts",
      "import": "./dist/adapters/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "pnpm --filter @agent-unit/runtime build && tsdown",
    "dev": "pnpm --filter @agent-unit/runtime build && tsdown --watch",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build",
    "check:pack": "node scripts/check-pack.mjs",
    "check:init": "node scripts/check-init.mjs"
  },
  "dependencies": {
    "@agent-unit/runtime": "workspace:^",
    "citty": "0.2.2",
    "consola": "3.4.2",
    "h3": "2.0.1-rc.32",
    "jiti": "2.7.0",
    "nitro": "3.0.260903-beta",
    "srvx": "1.0.5",
    "unstorage": "2.0.0-alpha.10"
  },
  "peerDependencies": {
    "@langchain/core": ">=1",
    "@langchain/langgraph": ">=1",
    "@mastra/core": ">=1",
    "@openai/agents": ">=0.19",
    "ai": ">=7"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.21",
    "@ai-sdk/google": "4.0.24",
    "@ai-sdk/openai": "4.0.20",
    "@langchain/anthropic": "1.5.12",
    "@langchain/core": "1.2.14",
    "@langchain/google-genai": "2.3.2",
    "@langchain/langgraph": "1.4.19",
    "@langchain/openai": "1.6.2",
    "@mastra/cloudflare-d1": "1.4.1",
    "@mastra/core": "1.74.0",
    "@mastra/hono": "1.7.16",
    "@mastra/libsql": "1.25.1",
    "@mastra/memory": "1.36.0",
    "@mastra/pg": "1.29.0",
    "@openai/agents": "0.19.0",
    "@types/node": "^20.19.43",
    "@upstash/redis": "1.39.0",
    "ai": "7.0.30",
    "hono": "4.13.13",
    "ioredis": "6.0.0",
    "miniflare": "4.20260730.0",
    "tsdown": "0.15.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "workerd": "^1.20261006.1",
    "zod": "4.3.6"
  },
  "packageManager": "pnpm@10.9.0"
}
