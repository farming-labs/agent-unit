{
  "name": "agent-unit",
  "version": "0.0.0",
  "description": "Durable runs, pauses and state for any agent framework, on any host.",
  "keywords": [
    "agents",
    "ai",
    "durable",
    "runtime",
    "nitro",
    "mcp",
    "a2a",
    "ai-sdk",
    "mastra",
    "langgraph"
  ],
  "license": "MIT",
  "author": "Farming Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farming-labs/agent-unit.git"
  },
  "homepage": "https://github.com/farming-labs/agent-unit#readme",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "agent-unit": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "spec"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime.d.mts",
      "import": "./dist/runtime.mjs"
    },
    "./adapter": {
      "types": "./dist/adapter.d.mts",
      "import": "./dist/adapter.mjs"
    },
    "./server": {
      "types": "./dist/server.d.mts",
      "import": "./dist/server.mjs"
    },
    "./build": {
      "types": "./dist/build.d.mts",
      "import": "./dist/build.mjs"
    },
    "./nitro": {
      "types": "./dist/nitro.d.mts",
      "import": "./dist/nitro.mjs"
    },
    "./client": {
      "types": "./dist/client.d.mts",
      "import": "./dist/client.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "import": "./dist/testing.mjs"
    },
    "./adapters/*": {
      "types": "./dist/adapters/*.d.mts",
      "import": "./dist/adapters/*.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "citty": "0.2.2",
    "h3": "2.0.1-rc.32",
    "jiti": "2.7.0",
    "nitro": "3.0.260903-beta",
    "srvx": "1.0.5",
    "unstorage": "2.0.0-alpha.10"
  },
  "peerDependencies": {
    "@langchain/core": ">=1",
    "@langchain/langgraph": ">=1",
    "@openai/agents": ">=0.19",
    "ai": ">=7",
    "@mastra/core": ">=1"
  },
  "peerDependenciesMeta": {
    "ai": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "@langchain/langgraph": {
      "optional": true
    },
    "@openai/agents": {
      "optional": true
    },
    "@mastra/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@langchain/core": "1.2.14",
    "@langchain/langgraph": "1.4.19",
    "@mastra/core": "1.74.0",
    "@openai/agents": "0.19.0",
    "@types/node": "^20.19.43",
    "ai": "7.0.30",
    "tsdown": "0.15.7",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "workerd": "^1.20261006.1",
    "zod": "4.3.6"
  },
  "packageManager": "pnpm@10.9.0"
}
