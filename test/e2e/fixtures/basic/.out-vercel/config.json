{
  "version": 3,
  "framework": {
    "name": "nitro",
    "version": "3.0.260903-beta"
  },
  "overrides": {},
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/__server"
    }
  ],
  "crons": [
    {
      "path": "/_vercel/cron",
      "schedule": "* * * * *"
    }
  ]
}