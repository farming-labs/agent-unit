{
  "compatibility_date": "2025-06-27",
  "main": "index.mjs",
  "assets": {
    "binding": "ASSETS",
    "directory": "../public"
  },
  "name": "farming-labs-agent-unit-test-e2e-fixtures-basic",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.mjs",
        "**/*.js"
      ]
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}