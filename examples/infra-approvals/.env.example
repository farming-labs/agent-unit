# An API key from Farm.js Infra > API keys ("Site analytics" grants agents:runtime).
FARMJS_API_KEY=
# The URL Infra calls to answer. Locally, Infra only reaches it when FARMJS_API_URL is local too.
AGENT_UNIT_URL=http://localhost:3030
# Only for a local Infra; the default is https://app.farmjs.dev.
# FARMJS_API_URL=http://localhost:3021
