{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "paths": {
      "@agent-unit/runtime": [
        "./packages/runtime/src/index.ts"
      ],
      "@agent-unit/runtime/redis": [
        "./packages/runtime/src/redis.ts"
      ],
      "@agent-unit/runtime/adapters/*": [
        "./packages/runtime/src/adapters/*.ts"
      ],
      "@agent-unit/runtime/*": [
        "./packages/runtime/src/*/index.ts"
      ],
      "agent-unit": [
        "./src/index.ts"
      ],
      "agent-unit/nitro": [
        "./src/nitro.ts"
      ],
      "agent-unit/build": [
        "./src/build/index.ts"
      ],
      "agent-unit/env": [
        "./src/env/index.ts"
      ],
      "agent-unit/adapters/*": [
        "./src/exports/adapters/*.ts"
      ],
      "agent-unit/*": [
        "./src/exports/*.ts"
      ],
      "tiny-agents": [
        "./test/e2e/fixtures/third-party/vendor/tiny-agents/index.d.ts"
      ],
      "agent-unit-adapter-tiny": [
        "./test/e2e/fixtures/third-party/vendor/agent-unit-adapter-tiny/index.d.ts"
      ]
    }
  },
  "include": [
    "src",
    "packages/runtime/src",
    "test",
    "*.config.ts"
  ]
}
